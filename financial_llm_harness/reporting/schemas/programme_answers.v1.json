  "required": [
    "row_id",
    "faq_id",
    "variant_id",
    "intervention_id",
    "experiment_key",
    "mode",
    "model_key",
    "run_id",
    "run_status",
    "oracle_type",
    "oracle_direction",
    "oracle_confidence",
    "estimand",
    "theta",
    "ci_low",
    "ci_high",
    "p_dev",
    "p_eq",
    "p_dev_adj",
    "p_eq_adj",
    "run_zone",
    "programme_zone",
    "run_label",
    "programme_label",
    "is_bias",
    "is_normative_failure",
    "attribution_label",
    "attribution_channel",
    "composite_label",
    "gates_failed",
    "run_label_row_id"
  ],
  "additionalProperties": false
}
