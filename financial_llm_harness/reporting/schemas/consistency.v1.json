{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "financial-harness:consistency.csv",
  "title": "consistency.csv",
  "description": "One row per model × check (pairwise or ranking experiments only).",
  "x-spec": "§32A.3, §T2.2",
  "x-format": "csv",
  "x-columns": [
    "row_id",
    "model_key",
    "faq_id",
    "check",
    "n",
    "rate",
    "ci_low",
    "ci_high"
  ],
  "type": "object",
  "properties": {
    "row_id": {
      "type": "string",
      "format": "uuid",
      "description": "UUIDv5 of the row's natural key",
      "x-type": "uuid",
      "x-unit": null,
      "x-spec": "§32A.2"
    },
    "model_key": {
      "type": "string",
      "description": "Model key `<prefix>--<8hex>`",
      "x-type": "string",
      "x-unit": null,
      "x-spec": "§20.6"
    },
    "faq_id": {
      "type": "string",
      "description": "Taxonomy item",
      "x-type": "string",
      "x-unit": null,
      "x-spec": "§T1"
    },
    "check": {
      "enum": [
        "antisymmetry",
        "transitivity"
      ],
      "description": "Check",
      "x-type": "enum",
      "x-unit": null,
      "x-spec": "§T2.2"
    },
    "n": {
      "type": "integer",
      "description": "Items checked",
      "x-type": "integer",
      "x-unit": null,
      "x-spec": "§T2.2"
    },
    "rate": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1,
      "description": "Violation rate",
      "x-type": "proportion",
      "x-unit": null,
      "x-spec": "§T2.2"
    },
    "ci_low": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1,
      "description": "CI lower bound",
      "x-type": "proportion",
      "x-unit": null,
      "x-spec": "§T2.2"
    },
    "ci_high": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1,
      "description": "CI upper bound",
      "x-type": "proportion",
      "x-unit": null,
      "x-spec": "§T2.2"
    }
  },
  "required": [
    "row_id",
    "model_key",
    "faq_id",
    "check",
    "n",
    "rate",
    "ci_low",
    "ci_high"
  ],
  "additionalProperties": false
}
